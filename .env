# Configuration de l'éditeur SPARQL, injectée dans le bundle par Vite au build.
# Surcharger dans un .env.local ou via l'environnement, puis reconstruire.

# Instance interrogée par l'éditeur.
VITE_SPARQL_ENDPOINT=http://rdf.insee.fr/sparql

# Préfixe appliqué aux liens id.insee.fr réécrits en requête DESCRIBE.
VITE_SPARQL_PREFIX=https://rdf.insee.fr/sparql?query=DESCRIBE

# Instance Insee de référence : les URI id.insee.fr y sont déréférençables, donc
# les liens ne sont réécrits que lorsque VITE_SPARQL_ENDPOINT pointe ailleurs.
# À ne pas surcharger — ce n'est pas une cible, c'est la valeur de comparaison.
VITE_INSEE_SPARQL_ENDPOINT=http://rdf.insee.fr/sparql
