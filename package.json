{
    "name": "impala",
    "type": "module",
    "version": "2.0.3-rc0",
    "dependencies": {
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    },
    "devDependencies": {
        "@babel/core": "^8.1.0",
        "@playwright/test": "^1.64.1",
        "@rolldown/plugin-babel": "^0.3.0",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/react": "16.3.3",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.2.1",
        "@vitest/coverage-v8": "^5.1.0",
        "archiver": "^8.0.0",
        "babel-plugin-react-compiler": "^1.0.0",
        "husky": "^9.1.7",
        "jscpd": "^5.4.2",
        "jsdom": "^31.0.0",
        "knip": "^6.44.1",
        "ncp": "^2.0.0",
        "oxlint": "^1.91.0",
        "oxlint-tsgolint": "^7.0.2006",
        "prettier": "^3.9.10",
        "react-doctor": "^0.9.22",
        "typescript": "^7.0.2",
        "vite": "^8.3.6",
        "vite-envs": "^4.7.2",
        "vitest": "^5.1.0"
    },
    "scripts": {
        "copy-static": "ncp pages build && ncp temp_dist build/sparql",
        "build-react": "vite build --base=/sparql",
        "start": "vite",
        "build": "pnpm build-react && pnpm copy-static && pnpm create-zip",
        "test": "vitest test",
        "test:coverage": "vitest run --coverage",
        "test:docker": "playwright test --config=playwright.docker.config.ts",
        "create-zip": "node create-zip.ts",
        "lint": "oxlint src/",
        "lint:fix": "oxlint src/ --fix",
        "typecheck": "tsc --noEmit",
        "knip": "knip",
        "jscpd": "jscpd .",
        "react-doctor": "react-doctor",
        "react-doctor:staged": "react-doctor --staged --no-supply-chain",
        "_format": "prettier \"**/*.{ts,tsx,css,html}\"",
        "format": "npm run _format -- --write",
        "prepare": "husky"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    }
}
