{
    "name": "impala",
    "type": "module",
    "version": "1.5.9",
    "dependencies": {
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    },
    "devDependencies": {
        "@playwright/test": "^1.45.3",
        "@testing-library/dom": "^10.4.0",
        "@testing-library/react": "16.3.2",
        "@types/node": "^22.19.19",
        "@vitejs/plugin-react-swc": "^4.3.1",
        "@vitest/coverage-v8": "^4.1.8",
        "archiver": "^8.0.0",
        "cross-env": "^7.0.3",
        "husky": "^9.1.7",
        "jsdom": "^29.0.0",
        "knip": "^6.15.0",
        "ncp": "^2.0.0",
        "oxfmt": "^0.63.0",
        "oxlint": "^1.68.0",
        "prop-types": "^15.8.1",
        "vite": "^8.0.0",
        "vitest": "^4.1.8"
    },
    "scripts": {
        "pre-script": "cross-env VITE_VERSION=$npm_package_version VITE_NAME=$npm_package_name",
        "copy-static": "ncp pages build && ncp temp_dist build/sparql",
        "build-react": "vite build --base=/sparql",
        "start": "pnpm pre-script vite",
        "build": "pnpm pre-script pnpm build-react && pnpm copy-static && pnpm create-zip",
        "test": "vitest test",
        "create-zip": "node create-zip.js",
        "lint": "oxlint src/",
        "lint:fix": "oxlint src/ --fix",
        "knip": "knip",
        "_format": "oxfmt \"**/*.{js,jsx,ts,tsx,css,html}\"",
        "format": "pnpm _format",
        "format:check": "pnpm _format --check",
        "prepare": "husky"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    }
}
